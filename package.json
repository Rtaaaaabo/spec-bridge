{
  "name": "spec-bridge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "analyze": "tsx apps/cli/src/index.ts analyze",
    "web": "pnpm --filter @spec-bridge/web dev",
    "test": "tsx --test \"packages/**/*.test.ts\" \"apps/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @spec-bridge/web exec tsc --noEmit -p tsconfig.json",
    "webhook": "pnpm --filter @spec-bridge/webhook dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
