{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@spec-bridge/core": ["packages/core/src/index.ts"],
      "@spec-bridge/core/*": ["packages/core/src/*"],
      "@spec-bridge/github": ["packages/github/src/index.ts"],
      "@spec-bridge/github/*": ["packages/github/src/*"],
      "@spec-bridge/jobs": ["packages/jobs/src/index.ts"],
      "@spec-bridge/jobs/*": ["packages/jobs/src/*"],
      "@spec-bridge/backfill": ["packages/backfill/src/index.ts"],
      "@spec-bridge/tenants": ["packages/tenants/src/index.ts"],
      "@spec-bridge/ingest": ["packages/ingest/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "apps/*/src/**/*.ts"]
}
