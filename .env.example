# GitHub Personal Access Token（Pull requests: Read-only + Contents: Read-only）
# Phase 0 は読み取りのみ
GITHUB_TOKEN=

# --- 以下は任意 ---

# Anthropic API key。
# 設定しなければ Claude Code のログイン情報が使われる（API クレジット不要）。
# 設定した場合は Agent SDK もこのキーを使い、API 利用料として課金される。
# ANTHROPIC_API_KEY=

# モデル上書き（省略時は Claude Code / Agent SDK の既定モデル）
# SPEC_BRIDGE_ANALYZE_MODEL=claude-opus-5
# SPEC_BRIDGE_CLASSIFY_MODEL=claude-sonnet-5

# 機能ドキュメントのローカルディレクトリ（CLI の書き出し先）
SPEC_BRIDGE_DOCS_PATH=./docs-example

# --- webhook サーバー（Phase 1）---
# 詳細は docs/github-app-setup.ja.md
# GITHUB_WEBHOOK_SECRET=
# 提出先の既定。インストールごとの設定（テナント表 installations）が優先され、
# 設定が無いインストールだけこの値に落ちる。単一テナント運用なら、これだけでも動く
# SPEC_BRIDGE_DOCS_REPO=owner/my-product-specs
# PORT=3939

# GitHub App のインストールトークンで動かす（推奨）。
# 設定すると、上の GITHUB_TOKEN ではなく installation access token で API を呼ぶ。
# App ID と秘密鍵は「両方」必要。片方だけだと起動時にエラーになる（黙って PAT に落とさない）。
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=/absolute/path/to/app.private-key.pem
# 秘密鍵を1行で持たせる場合は改行を \n にエスケープする
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"

# ジョブの置き場所。webhook は受信してここへ積むだけで、解析は worker が行う。
# 未設定だとメモリに積む（プロセスを落とすと消える／別プロセスの worker には届かない）。
# DATABASE_URL=postgres://user@localhost:5432/spec_bridge

# 1プロセスで受信と実行の両方をやる（ローカル用。本番はプロセスを分ける）
# SPEC_BRIDGE_INLINE_WORKER=1

# PR 1本あたりの上限（USD、既定 10）。webhook は自動で走るので上限が要る。
# 大規模 PR は実測で6機能・約 $15。超えた機能は書かずに、その旨を docs の PR に書く
# SPEC_BRIDGE_PR_BUDGET_USD=10

# 見積もりの係数。既定は gitea #38966 の実測（1機能 $2.5・4.5分）。
# リポジトリの大きさで変わる（小さい例示リポジトリでは約 $0.4 だった）ので、
# 自分のリポジトリで実測したら上書きする
# SPEC_BRIDGE_COST_PER_FEATURE_USD=2.5
# SPEC_BRIDGE_MINUTES_PER_FEATURE=4.5

# 機能の解析を同時に走らせる数（既定 1）。**費用は変わらず実時間だけ縮む**。
# 大きくすると LLM の利用上限に当たりやすくなるので、既定は直列
# SPEC_BRIDGE_ANALYZE_CONCURRENCY=2
